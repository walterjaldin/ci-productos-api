{
  "name": "ci-productos-api",
  "version": "1.0.0",
  "description": "API CRUD de productos con CI en GitHub Actions",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build": "node -e \"require('./src/app'); console.log('Build OK: la app carga correctamente')\"",
    "lint": "eslint .",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/walterjaldin/ci-productos-api.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/walterjaldin/ci-productos-api/issues"
  },
  "homepage": "https://github.com/walterjaldin/ci-productos-api#readme",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 80,
        "functions": 80,
        "lines": 80
      }
    }
  }
}
